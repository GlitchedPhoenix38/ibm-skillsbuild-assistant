# ---------------------------------------------------------------------------
# IBM SkillsBuild Assistant - local configuration
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored. Never commit real API keys.
# NEVER put your IBM username/password here. This tool never asks for it and
# never stores IBM credentials, cookies, or session tokens.
# ---------------------------------------------------------------------------

# --- Dry run ---------------------------------------------------------------
# true  = read questions, ask the AI, print the answer, click NOTHING
# false = allow normal UI interaction (select / submit) on the visible page
DRY_RUN=true

# --- Brave connection (Chrome DevTools Protocol) ----------------------------
# Port used by the Brave instance you launch with --remote-debugging-port
BRAVE_CDP_PORT=9222
# Brave executable (auto-detected if not set)
# BRAVE_PATH=/usr/bin/brave
# Full CDP endpoint. If set, it overrides BRAVE_CDP_PORT.
# BRAVE_CDP_URL=http://127.0.0.1:9222
# Headless is NOT supported for attach mode; Brave must be visible.
HEADLESS=false
# Reuse an already-open tab whose URL matches this prefix if no SkillsBuild
# tab is found. Empty = use the active tab.
# TAB_URL_HINT=https://skills.yourlearning.ibm.com
# Slower / older machines can raise these timeouts (ms)
BROWSER_CONNECT_TIMEOUT_MS=30000
NAV_TIMEOUT_MS=60000
ACTION_TIMEOUT_MS=20000

# --- Learning plan ----------------------------------------------------------
PLAN_URL=https://skills.yourlearning.ibm.com/activity/PLAN-8749C02A78EC

# --- AI provider (any OpenAI-compatible /chat/completions endpoint) ---------
# Examples:
#   OpenAI        : https://api.openai.com/v1
#   Ollama        : http://127.0.0.1:11434/v1
#   LM Studio     : http://127.0.0.1:1234/v1
#   llama.cpp     : http://127.0.0.1:8080/v1
#   OpenRouter    : https://openrouter.ai/api/v1
#   Groq          : https://api.groq.com/openai/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0
AI_MAX_TOKENS=500
AI_TIMEOUT_MS=60000
# Optional: some gateways require this (e.g. OpenRouter)
# AI_EXTRA_HEADERS={"X-Title":"ibm-skillsbuild-assistant"}
# Sent as a hint only; the model still returns strict JSON.
AI_REQUEST_TIMEOUT_RETRIES=2

# --- Automation safety ------------------------------------------------------
# Max attempts on the same question before stopping for manual help.
MAX_QUESTION_ATTEMPTS=3
# Max consecutive course-level steps before re-reading progress.
MAX_COURSE_STEPS=400
# Max courses to process in one run.
MAX_COURSES_PER_RUN=20
# Max questions answered in one run.
MAX_QUESTIONS_PER_RUN=200
# Pause and wait for a human when CAPTCHA / MFA / login is detected.
# Set to 0 to never wait (fail fast instead).
HUMAN_WAIT_TIMEOUT_MS=0
# Progress file location (relative to project root)
PROGRESS_FILE=progress.json
# Screenshot output directory (relative to project root)
SCREENSHOT_DIR=debug/screenshots
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
