{
  "name": "ibm-skillsbuild-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local browser automation assistant for the IBM SkillsBuild Web Development Fundamentals learning plan (DRY_RUN first).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
    "doctor": "tsx src/index.ts --doctor",
    "plan": "tsx src/index.ts --mode plan",
    "extract": "tsx src/index.ts --mode extract"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright-core": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
